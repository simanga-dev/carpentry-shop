APP_DOMAIN=carpentry.example.com
ACME_EMAIL=ops@example.com
APP_TAG=latest
# Host interface for Caddy's ports. Loopback keeps the stack off the network.
# Set to 0.0.0.0 only on a public server.
APP_BIND_ADDRESS=127.0.0.1
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
ADMIN_EMAIL=admin@example.com
# Use a unique password with uppercase, lowercase, digits, and punctuation.
ADMIN_PASSWORD=
